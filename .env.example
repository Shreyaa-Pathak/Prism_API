DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/prism
SESSION_SECRET=<random-secret-at-least-32-characters>
PRISM_PUBLIC_URL=http://localhost:3000
# Optional: enables the admin-only observed operations endpoint for CI.
ADMIN_TOKEN=<strong-random-admin-token>
# Docker Compose only: replace all placeholders.
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<strong-database-password>
POSTGRES_DB=prism
# Optional development seed only. Never use a real account password.
DEV_SEED_PASSWORD=<development-only-password-at-least-12-characters>
# Optional public sample workspace. This key is intentionally shown to visitors.
# Generate a distinct value (24+ characters), run db:migrate then sandbox:setup.
# PRISM_SANDBOX_KEY=prism_sandbox_<random-public-demo-credential>
