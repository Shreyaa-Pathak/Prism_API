  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/db-setup.ts",
    "sdk:generate": "tsx scripts/generate-sdk.ts",
    "schema:snapshot": "tsx scripts/schema-snapshot.ts",
    "schema:check": "tsx scripts/check-schema.ts",
    "sandbox:setup": "tsx scripts/sandbox-setup.ts",
    "demo:schema-check": "tsx scripts/demo-schema-check.ts",
    "db:migrate": "tsx scripts/db-setup.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/schema-check.test.ts tests/integration.test.ts",
    "test:schema": "tsx --test tests/schema-check.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.6",
    "@next/env": "^15.5.28",
    "dataloader": "^2.2.2",
    "geist": "^1.3.1",
    "graphql": "^16.9.0",
    "next": "^15.5.28",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.29"
    }
  }
